# Provider 配置示例
# 通过 HARNESS_PROVIDERS_CONFIG 指向此文件启用
# 复制此文件为 providers.toml 并填入实际 API Key
#
# 每个 provider 通过 api_key_env 指定从哪个环境变量读取 API Key，
# 避免在配置文件中明文存储密钥。

default_fallback_cooldown_secs = 60
default_provider = "openai"

[[provider]]
name = "openai"
kind = "OpenAi"
api_key_env = "OPENAI_API_KEY"

[[provider]]
name = "deepseek"
kind = "DeepSeek"
api_key_env = "DEEPSEEK_API_KEY"

# 可选：按模型配置单价（元 / 百万 token），用于客户端「用量」页折算费用。
# 未配置单价的模型只统计 token；cached_input 缺省时缓存命中部分按 input 计价。
# 费用在记账时按当时单价写入 .harness/usage/，之后改单价不影响历史记录。
[provider.pricing."deepseek-chat"]
input = 2.0
output = 8.0
cached_input = 0.5

[[provider]]
name = "openrouter"
kind = "OpenAiCompatible"
api_key_env = "OPENROUTER_API_KEY"
api_base = "https://openrouter.ai/api/v1"
# 可选：语音转写（OpenAI 兼容的 /audio/transcriptions 接口）。
# 配置后 Telegram 语音、以及 QQ 平台未给出识别文本的语音会先转写为文本再进入任务；
# 未配置时语音只以 [VOICE:path] 标记进入任务。api_base 缺省为 OpenAI 官方地址，
# 也可指向 Groq、SiliconFlow 或本地 whisper 服务。支持 wav/mp3/m4a/ogg/webm/flac。
[transcription]
api_key_env = "OPENAI_API_KEY"
model = "whisper-1"
# api_base = "https://api.openai.com/v1"
# language = "zh"
