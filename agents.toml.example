# Agent 配置示例
# 通过 HARNESS_AGENTS_CONFIG 指向此文件启用
# 复制此文件为 agents.toml 并根据需要修改

[[agent]]
name = "default-llm-agent"
tags = ["llm", "default", "general"]
description = "默认 LLM Agent，处理通用任务"

# 多模型降级链示例：按顺序声明，第一个为最高优先级
[[agent.models]]
provider = "openai"
model = "gpt-4.1-mini"

[[agent.models]]
provider = "deepseek"
model = "deepseek-chat"
fallback_cooldown_secs = 120

[agent.tools]
default_permission = "Confirm"
spawn_agent = "Deny"
execute_code = "Deny"
read_file = "Allow"
write_file = "Confirm"
search_web = "Allow"

[[agent]]
name = "brain"
tags = ["brain", "dispatcher"]
description = "Brain Agent，负责调度决策"

[[agent.models]]
provider = "openai"
model = "gpt-4.1-mini"

[agent.tools]
default_permission = "Deny"
spawn_agent = "Deny"
read_file = "Allow"

[[agent]]
name = "summarizer"
tags = ["summarization", "memory"]
description = "记忆摘要专家，负责压缩对话历史"

[[agent.models]]
provider = "openai"
model = "gpt-4.1-mini"

[agent.tools]
default_permission = "Deny"

[[agent]]
name = "evaluator"
tags = ["evaluation"]
description = "任务评估专家，负责评估任务执行状态"

[[agent.models]]
provider = "openai"
model = "gpt-4.1-mini"

[agent.tools]
default_permission = "Deny"

[[agent]]
name = "collector"
tags = ["collect", "experience"]
description = "经验收敛专家，负责从任务终态材料中提炼经验候选"

[[agent.models]]
provider = "openai"
model = "gpt-4.1-mini"

[agent.tools]
default_permission = "Deny"
submit_experience_candidate = "Allow"

[[agent]]
name = "knowledge-manager"
tags = ["knowledge", "management"]
description = "知识库管理员，负责知识检索与维护"

[[agent.models]]
provider = "openai"
model = "gpt-4.1-mini"

[agent.tools]
default_permission = "Deny"
shell_exec = "Confirm"
shell_read = "Allow"
shell_list = "Allow"

[[agent]]
name = "profile-designer"
tags = ["profile", "design"]
description = "Agent 元信息设计师，负责根据经验候选生成 Agent 角色名、能力标签和职责描述"
system_prompt = """\
你是一名 Agent 元信息设计师。你必须根据提供的经验候选，生成 Agent 的角色名、能力标签和职责描述。\
每次响应必须调用 submit_profile_update 或 skip_profile_update 之一提交结果，\
不能同时调用两个工具，也不能仅返回文本而不调用工具。\
若无法根据材料生成合理的 profile，调用 skip_profile_update。\
"""

[[agent.models]]
provider = "deepseek"
model = "deepseek-chat"

[agent.tools]
default_permission = "Deny"
submit_profile_update = "Allow"
skip_profile_update = "Allow"

[[agent]]
name = "skill-updater"
tags = ["skill-updater", "persistent"]
description = "负责根据经验候选更新已有 skill 的 instruction，通过 submit_skill_update 工具提交结构化更新操作"
system_prompt = """\
你是一个 skill 更新专家。根据经验候选和原 skill 内容，通过 submit_skill_update 工具提交结构化更新操作。\
你必须基于原 skill 的 instructions 和触发更新的经验候选，识别需要新增、修改、删除的章节，\
然后通过 submit_skill_update 工具提交 operations 数组。\
每次响应必须调用 submit_skill_update 工具一次，不能仅返回文本而不调用工具。\
"""
model = "deepseek-chat"

[[agent.models]]
provider = "deepseek"
model = "deepseek-chat"

[agent.tools]
default_permission = "Deny"
submit_skill_update = "Allow"
