# Agent 配置示例
# 通过 HARNESS_AGENTS_CONFIG 指向此文件启用
# 复制此文件为 agents.toml 并根据需要修改
#
# 多 Agent 按职责分工：用户任务直接交给主 Agent（默认 default-llm-agent，
# 可用 HARNESS_MAIN_AGENT 指定），其余 Agent 按 tags 承担服务角色：
# summarization（摘要）、evaluation（完成度评估）、experience-librarian（经验库）、
# watchdog（监督后台工具调用与子任务进展）。

[[agent]]
name = "default-llm-agent"
tags = ["llm", "default", "general"]
description = "默认 LLM Agent，处理通用任务"

# 多模型降级链示例：按顺序声明，第一个为最高优先级
# vision = true 声明该模型接受图片输入；降级到未声明的模型时图片以文本标记发送
[[agent.models]]
provider = "openai"
model = "gpt-4.1-mini"
vision = true

[[agent.models]]
provider = "deepseek"
model = "deepseek-chat"
fallback_cooldown_secs = 120

# 不写 default_permission 时按各工具自身默认权限（shell_exec / shell_start 等需确认，
# 读取类工具直接允许）；显式写 default_permission 会覆盖所有工具的默认值。
# 下面按工具名逐个覆盖，工具名见 docs/current-state.md "工具与会话"。
[agent.tools]
shell_exec = "Confirm"
shell_start = "Confirm"
channel_send = "Confirm"
update_todos = "Allow"  # 仅更新展示清单，不执行工作
search_experience = "Allow"  # 查经验库，由经验管理员判断，只读

[[agent]]
name = "summarizer"
tags = ["summarization", "memory"]
description = "记忆摘要专家，负责压缩对话历史"

[[agent.models]]
provider = "openai"
model = "gpt-4.1-mini"

[agent.tools]
default_permission = "Deny"

[[agent]]
name = "evaluator"
tags = ["evaluation"]
description = "任务评估专家，负责评估任务执行状态"

[[agent.models]]
provider = "openai"
model = "gpt-4.1-mini"

[agent.tools]
default_permission = "Deny"

# 经验管理员：为主 Agent 检索经验库、把客户端发起的总结整理成经验草稿。
# 只做判断与撰写，不需要任何工具；建议配置响应快的模型以缩短检索等待。
[[agent]]
name = "experience-librarian"
tags = ["experience-librarian"]
description = "经验管理员，负责经验检索与经验草稿撰写"
system_prompt = """
你是经验管理员，为直接与用户协作的主 Agent 维护经验库。经验库记录以往任务中验证过的做法和走不通的路线，目的是让主 Agent 遇到类似问题时不必从零尝试。

你会收到两类请求：
1. 检索：判断经验库目录中哪些经验能直接帮助当前情况。宁缺毋滥：话题相近但做法无法迁移的不要选，没有合适的就返回空结果。
2. 起草：把一次会话中的尝试过程整理成经验草稿。重点写清试过但失败的路线及原因、最终可行的做法；只写记录中能确认的事实。

严格按请求中给出的 JSON 格式输出，不要输出其他文字。"""

[[agent.models]]
provider = "openai"
model = "gpt-4.1-mini"

[agent.tools]
default_permission = "Deny"

# Watchdog：定时（HARNESS_WATCHDOG_INTERVAL_SECS，默认 120 秒）及在子任务检查点、重复调用、
# 连续失败时监督自动转后台的工具调用与运行中的子任务，决定继续、调整（向子任务注入建议）、
# 要求收尾交付、升级给所属任务、取消或重试；子任务没有轮次上限，是否继续由它判断。
# 同时作为子任务的审批者：子任务调用需要确认的工具时先由它批准 / 拒绝，必要时升级给用户。
# 只做判断，不需要任何工具；未配置本 Agent 时不监督子任务，子任务的确认请求直接交给用户。
# 建议配置响应快、成本低的模型。
[[agent]]
name = "watchdog"
tags = ["watchdog"]
description = "Watchdog，监督后台工具调用与子任务的进展，并审批子任务的工具调用"
system_prompt = """
你是 Harness 的 watchdog，在主 Agent 之外监督后台工作，让主 Agent 不必把注意力花在盯进度上。
判断要克制：耗时长不等于没有进展，只有证据长期不变、反复执行同一失败操作或明显偏离目标时才干预；
干预前参考历史决策，同一手段无效时升级而不是重复。

严格按请求中给出的 JSON 格式输出，不要输出其他文字。"""

[[agent.models]]
provider = "openai"
model = "gpt-4.1-mini"

[agent.tools]
default_permission = "Deny"
