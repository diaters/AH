HARNESS_LLM_PROVIDER=openai-compatible
HARNESS_MODEL=gpt-4.1-mini
HARNESS_LLM_API_KEY=your_api_key_here
HARNESS_LLM_API_BASE=https://example.com/v1

# Brain Agent 配置
# HARNESS_BRAIN_ENABLED=false

# 运行时参数
# HARNESS_MAX_RETRIES=3
# HARNESS_MAX_TOOL_ITERATIONS=5
# HARNESS_DEFAULT_WAIT_TASKS_TIMEOUT_SECS=300
# HARNESS_AGENTS_CONFIG=agents.toml
# HARNESS_LOG_DIR=logs

# Shell Runtime
# HARNESS_SHELL_DEFAULT_TAIL_LINES=200
# HARNESS_SHELL_MAX_TAIL_LINES=500
# HARNESS_SHELL_DEFAULT_EXEC_TIMEOUT_SECS=300
# HARNESS_SHELL_DEFAULT_STOP_TIMEOUT_SECS=10
# HARNESS_SHELL_MAX_BUFFER_BYTES_PER_STREAM=65536

# 标准 provider 可根据底层 SDK 约定直接配置环境变量
# 例如：
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_BASE_URL=https://api.openai.com/v1
