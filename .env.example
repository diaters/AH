HARNESS_LLM_PROVIDER=openai-compatible
HARNESS_MODEL=gpt-4.1-mini
HARNESS_LLM_API_KEY=your_api_key_here
HARNESS_LLM_API_BASE=https://example.com/v1

# Provider 环境变量（用于 providers.toml）
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...

# Provider 配置文件路径
# HARNESS_PROVIDERS_CONFIG=providers.toml

# 主 Agent：用户任务直接交给它处理（需在 agents.toml 中存在）
# HARNESS_MAIN_AGENT=default-llm-agent

# 运行时参数
# HARNESS_MAX_RETRIES=3
# HARNESS_LLM_REQUEST_TIMEOUT_SECS=300
# HARNESS_TERMINAL_TASK_RETENTION_SECS=3600
# 多轮会话空闲超过该时长（秒）后自动结束，0 表示关闭
# HARNESS_CONVERSATION_IDLE_SECS=86400
# HARNESS_MAX_TOOL_ITERATIONS=5
# HARNESS_DEFAULT_WAIT_TASKS_TIMEOUT_SECS=300
# Agent loop 控制：滚动窗口内后台自动拉起额度 / 窗口（秒）/ 通知合并与轮询间隔（毫秒）
# HARNESS_MAX_AUTO_WAKES=5
# HARNESS_AUTO_WAKE_WINDOW_SECS=10
# HARNESS_NOTIFICATION_COALESCE_MS=300
# HARNESS_BACKGROUND_POLL_MS=500
# 异步工具调用全局失联超时（秒），sweeper 推导 max_duration 的全局缺省
# HARNESS_TOOL_INFLIGHT_TIMEOUT_SECS=300
# HARNESS_AGENTS_CONFIG=agents.toml
# HARNESS_LOG_DIR=logs

# 以下主循环参数已废弃，兼容读取但不生效；运行时按事件和截止时间唤醒
# HARNESS_ACTIVE_POLL_MS=16
# HARNESS_IDLE_POLL_MS=150

# 记忆压缩配置
# 短期记忆 token 压缩触发阈值
# HARNESS_MEMORY_COMPRESSION_THRESHOLD_TOKENS=8000
# LLM 摘要目标 token 数
# HARNESS_MEMORY_SUMMARY_TARGET_TOKENS=1000

# Shell Runtime
# HARNESS_SHELL_DEFAULT_TAIL_LINES=200
# HARNESS_SHELL_MAX_TAIL_LINES=500
# HARNESS_SHELL_DEFAULT_EXEC_TIMEOUT_SECS=300
# HARNESS_SHELL_DEFAULT_STOP_TIMEOUT_SECS=10
# HARNESS_SHELL_MAX_BUFFER_BYTES_PER_STREAM=65536

# IM / 原生客户端通道配置（HTTPS 客户端见 docs/client-channel.md）
# HARNESS_CHANNELS_CONFIG=channels.toml
# MeoW 接收昵称；仅在 channels.toml 的 [client.meow.recipients] 中引用时生效
# HARNESS_MEOW_RECIPIENT=your_meow_nickname
# Telegram Bot Token（也可直接写在 channels.toml 的 bot_token 字段）
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Telegram 配对（channels.toml 的 [telegram] 段）
# pairing_enabled = false
# pairing_code = your_pairing_code

# QQ Bot 配置（channels.toml 的 [qq] 段）
# QQ_APP_ID=1234567890
# QQ_APP_SECRET=your_app_secret

# 信号触发系统配置
# HARNESS_TRIGGERS_CONFIG=triggers.toml

# 标准 provider 可根据底层 SDK 约定直接配置环境变量
# 例如：
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_BASE_URL=https://api.openai.com/v1

# 定时监控连续失败首次告警阈值
HARNESS_SCHEDULE_FAILURE_ALERT_THRESHOLD=3
