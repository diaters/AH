# IM 通道配置示例
# 通过 HARNESS_CHANNELS_CONFIG 指向此文件启用
# 复制此文件为 channels.toml 并填入实际凭证

[telegram]
# 也可通过 TELEGRAM_BOT_TOKEN 环境变量提供
bot_token = "your-bot-token-here"
allowed_users = ["your-username"]
pairing_enabled = false

[qq]
# app_id 和 app_secret 也可通过 QQ_APP_ID / QQ_APP_SECRET 环境变量提供
app_id = "your-app-id"
app_secret = "your-app-secret"
allowed_users = []
pairing_enabled = false

# 原生客户端通道（见 docs/client-channel.md；省略证书时自管私有 CA，用 --client-pair 生成配对链接）
# [client]
# listen = "0.0.0.0:9443"
# instance_name = "我的 Harness"
# state_path = ".harness/client/state.json"
# advertise = ["192.168.1.10"]  # 可选：客户端可达地址，省略时使用本机网卡地址
# tls_cert = ".harness/client/server.pem"  # 可选：使用公网可信证书时与 tls_key 一起配置
# tls_key = ".harness/client/server-key.pem"

# 可选：服务端自动通知；用户 ID 与 --client-pair 的用户一致，昵称不放入客户端。
# [client.meow]
# daily_limit = 3000
# utc_offset_minutes = 480
# [client.meow.recipients]
# alice = "${HARNESS_MEOW_RECIPIENT}"
